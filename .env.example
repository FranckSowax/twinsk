# ============================================================
# Variables d'environnement — un jeu par déploiement (pays).
# Ne jamais commiter de vraies valeurs : les saisir dans Railway.
# ============================================================

# --- Pays du déploiement : GA (Oh My Gab, défaut) | CI (Oh My Cot) ---
NEXT_PUBLIC_COUNTRY=GA
# Domaine public, sans barre finale (défaut : domaine du pays dans src/config/countries.ts)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Supabase (un projet par pays) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Accès admin (sert aussi à signer les sessions collaborateurs et agents) ---
ADMIN_PASSWORD=
CRON_SECRET=

# --- WhatsApp (WHAPI : un canal = un numéro par pays) ---
WHAPI_TOKEN=
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_GROUP_ID=
WHAPI_ORDERS_GROUP_ID=
WHAPI_STAFF_GROUP_ID=
WHAPI_WEBHOOK_SECRET=
# Numéro WhatsApp de la marque, chiffres seuls (défaut : COUNTRY.supportWhatsapp)
NEXT_PUBLIC_OMG_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBER=

# --- Paiement (Gabon : Airtel Money manuel ; Côte d'Ivoire : phase 4) ---
AIRTEL_MONEY_NUMBER=

# --- Tarifs de fret (facultatifs ; défauts : COUNTRY.freight) ---
AIR_RATE_FCFA_PER_KG=
AIR_BATTERY_RATE_FCFA_PER_KG=
AIR_MAX_UNIT_VOLUME_M3=
SEA_RATE_FCFA_PER_M3=
SEA_RATE_FLOOR_FCFA_PER_M3=

# --- Publication Facebook / Instagram (page du pays) ---
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=

# --- Alertes internes ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Services partagés entre pays ---
RAPIDAPI_KEY=
KIMI_API_KEY=

# --- Système ---
# off = désactive le planificateur de diffusion intégré au serveur web
DRIP_INTERNAL_SCHEDULER=
